      "column": 0,
      "level": "external",
      "title": "The operator",
      "lines": [
        "an Android 8.0+ phone at home",
        "or away, with the server's",
        "own login"
      ]
    },
    {
      "id": "studio",
      "column": 0,
      "level": "external",
