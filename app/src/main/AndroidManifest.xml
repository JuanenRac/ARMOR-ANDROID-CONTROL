<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required only to hand a verified update APK (downloaded from this
         project's own GitHub Releases) to Android's system package
         installer. The app never installs a package silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The watch for alarms is a service that must go on all day: a data-sync service is stopped by Android 15 after six hours, so from Android 14 it runs as a "special use" one (it has no such limit). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The watch starts again when the phone does, if the person had it on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Configuring a field node over Bluetooth Low Energy (the node advertises "ARMOR-xxxxxx"). Location is only asked for on Android 11 and older,
         where scanning needs it, and the app never uses it for anything else. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- ARMOR-SERVER normally runs inside a trusted LAN without TLS. The
         endpoint parser still rejects arbitrary public HTTP origins. -->
    <!-- The Assistant screen speaks the answers (the phone's text-to-speech) and listens through the phone's own speech recognition: from Android 11 an app has to say
         which of those services it looks for. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="A.R.M.O.R."
        android:theme="@style/Theme.Armor"
        android:usesCleartextTraffic="true">
        <activity android:name=".ArmorActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".AlarmWatcherService" android:exported="false" android:foregroundServiceType="specialUse|dataSync">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Watches the A.R.M.O.R. server for new alarms and tells the person at once" />
        </service>
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <!-- Shares an APK held in the app cache with Android's package
             installer through a temporary content:// URI; no file:// URI or
             broad external-storage permission is needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
